# referral-intake configuration. Copy to .env (gitignored); scripts and the API
# load it with python-dotenv, and real environment variables win over it.
# Exactly the variables the code reads (docs/CONTRACTS.md section 3). Comments
# sit on their own lines: some loaders do not strip inline comments.
# Values below are the `make demo` settings.

# Required, no default anywhere. make demo starts this Postgres (pgvector) for you.
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:55432/faxtract

# Which pipeline the API serves: graph (LangGraph v2, human-in-the-loop) or v1.
PIPELINE=graph

# Extraction engine: claude (live, needs ANTHROPIC_API_KEY), fixture (ground truth), replay (recorded Claude run).
EXTRACTOR=replay

# Only for EXTRACTOR=claude (and keyed eval runs). Leave empty without a key.
ANTHROPIC_API_KEY=

# Auto-approve gate: every field's extraction confidence must be at least this.
CONFIDENCE_THRESHOLD=0.85

# Mock RIS MLLP listener (ris/server.py) and the API's HL7 client.
RIS_MLLP_HOST=127.0.0.1
RIS_MLLP_PORT=2575

# JSON file where the mock RIS keeps received orders (the MCP server reads it too).
RIS_STORE_PATH=ris/orders.json

# Comma list of patient last names the mock RIS answers with MSA|AE (demo fault injection; make demo sets one).
RIS_FAULT_LAST_NAMES=

# Seconds the replay engine may sleep per extraction (capped at the recorded latency) so the graph animates; 0 = instant.
REPLAY_PACE_S=12

# Where the API stores uploaded faxes (uploads/<referral_id>/<file name>).
UPLOADS_DIR=uploads

# Directory holding pdftoppm/pdfinfo, only if poppler is not on PATH.
POPPLER_PATH=

# 1 = never contact the HuggingFace hub (set once all-MiniLM-L6-v2 is cached; the first index downloads ~90 MB).
HF_HUB_OFFLINE=0
